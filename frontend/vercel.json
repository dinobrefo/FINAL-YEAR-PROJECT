{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ierbms-backend.onrender.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://ierbms-backend.onrender.com/socket.io/$1"
    },
    {
      "source": "/ml-api/(.*)",
      "destination": "https://ierbms-ml-engine.onrender.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
