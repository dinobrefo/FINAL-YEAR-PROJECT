# --- Backend configuration -------------------------------------------------
# Copy to backend/.env for local development. Never commit the real .env.

# Postgres. Either a single URL (Neon / Render) ...
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_SSL=false            # set to disable SSL (local docker postgres)
# ... or discrete parts (used only when DATABASE_URL is unset):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5434
# POSTGRES_USER=ierbms_user
# POSTGRES_PASSWORD=ierbms_password
# POSTGRES_DB=ierbms

# REQUIRED in production — the app refuses to boot without it.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowlist of browser origins (required in production).
# CORS_ORIGINS=https://pulsegrid.vercel.app,https://www.pulsegrid.app

# Run the GPS simulator in THIS process. Enable on exactly one instance.
ENABLE_SIMULATOR=false

# Optional CARTO integration (isolines / routing / geocoding).
# When unset, the app falls back to keyless OSM/haversine estimates.
# CARTO_ACCOUNT_ID=
# CARTO_API_ACCESS_TOKEN=

# PORT=5001
# NODE_ENV=production
